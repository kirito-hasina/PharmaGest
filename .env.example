# Copiez ce fichier en .env et adaptez-le. Ne versionnez jamais .env.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=remplacez-par-une-longue-valeur-aleatoire
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# En production (DEBUG=False) : HTTPS obligatoire, SMTP à configurer
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=True
